# Copy to .env.local and fill in. Never commit .env.local.
#
# Without RESEND_API_KEY the contact form still renders and validates, but
# submitting returns 503 and the UI falls back to a pre-filled mailto link.
# Nothing breaks — the form just isn't wired to an inbox yet.

# 1. Create a free account at https://resend.com
# 2. API Keys -> Create API Key (sending access is enough)
RESEND_API_KEY=

# The "from" address. Must be on a domain you've verified in Resend.
# Leave blank to use Resend's shared sandbox sender, which ONLY delivers to
# the email address on your own Resend account — fine for testing, not for
# real enquiries.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Where enquiries land. Defaults to personalInfo.email in lib/data.ts.
CONTACT_TO_EMAIL=
